# ==============================================================================
# Project TenantPlus — Environment Variable Template
# Copy to .env or configure in Cloud Provider dashboard (Vercel / Render)
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vercel)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://tenantplus-backend.onrender.com

# ------------------------------------------------------------------------------
# Backend Environment Variables (Cloud Run / Render / Container)
# ------------------------------------------------------------------------------
PORT=8000
ALLOWED_ORIGINS=https://tenantplus.vercel.app,http://localhost:3000

# Supabase PostgreSQL Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# AI Vision & Antigravity Agent API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-google-cloud-api-key-here
USE_VERTEX_AI=false
